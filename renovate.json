{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "local>victron-venus/venus-os-ci-toolkit:renovate-fleet"
  ],
  "enabledManagers": [
    "custom.jsonata",
    "custom.regex",
    "github-actions",
    "pep621",
    "pip-compile",
    "pip_requirements"
  ],
  "ignorePaths": [
    "**/vendor/**",
    "**/node_modules/**",
    "**/fixtures/**",
    "**/tools/browser-compatibility/**",
    "security/provider/**",
    "build-support/tls-armv7/**"
  ],
  "packageRules": [
    {
      "matchManagers": [
        "pep621"
      ],
      "matchFileNames": [
        "/^[^/]+$/"
      ],
      "schedule": [
        "* * * * 1"
      ]
    },
    {
      "description": "Preserve the explicitly named legacy Bandit 1.9.2 toolchain while allowing its transitive lock maintenance.",
      "matchManagers": [
        "pip-compile"
      ],
      "matchFileNames": [
        ".github/requirements-bandit-1.9.2.in"
      ],
      "matchPackageNames": [
        "bandit"
      ],
      "allowedVersions": "==1.9.2"
    }
  ],
  "pip_requirements": {
    "managerFilePatterns": [
      "/(^|/)requirements[^/]*\\.(txt|pip)$/"
    ],
    "ignorePaths": [
      "**/vendor/**",
      "**/node_modules/**",
      "**/fixtures/**",
      "**/tools/browser-compatibility/**",
      "security/provider/**",
      "build-support/tls-armv7/**",
      ".github/requirements-bandit-1.9.2.txt",
      ".github/requirements-bandit.txt",
      ".github/requirements-fuzz.txt"
    ]
  },
  "pip-compile": {
    "managerFilePatterns": [
      "/^\\.github/requirements\\-bandit\\-1\\.9\\.2\\.txt$/",
      "/^\\.github/requirements\\-bandit\\.txt$/",
      "/^\\.github/requirements\\-fuzz\\.txt$/"
    ]
  }
}
