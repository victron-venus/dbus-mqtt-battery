#!/bin/bash

# dbus-mqtt-battery SetupHelper compatible setup script
# MQTT to D-Bus bridge for JBD BMS batteries on Victron Venus OS

#### following line incorporates SetupHelper resources into this script
source "/data/SetupHelper/HelperResources/IncludeHelpers"
#### end of lines to include helper resources

# Default configuration
defaultChains="2"
defaultBatteries="4"
defaultCellsPerBms="4"

# Read configuration from setupOptions
readConfig() {
    if [ -f "$setupOptionsDir/chains" ]; then
        chains=$(cat "$setupOptionsDir/chains")
    else
        chains="$defaultChains"
    fi

    if [ -f "$setupOptionsDir/batteries" ]; then
        batteries=$(cat "$setupOptionsDir/batteries")
    else
        batteries="$defaultBatteries"
    fi

    if [ -f "$setupOptionsDir/cellsPerBms" ]; then
        cellsPerBms=$(cat "$setupOptionsDir/cellsPerBms")
    else
        cellsPerBms="$defaultCellsPerBms"
    fi
}

# Create a chain service
createChainService() {
    local chainNum=$1
    local serviceName="dbus-mqtt-chain${chainNum}"
    local dbusSuffix="mqtt_chain${chainNum}"
    local instance=$((511 + chainNum))

    # Topic prefix: chain1=battery, chain2=battery2, chain3=battery3, etc.
    if [ "$chainNum" -eq 1 ]; then
        topicPrefix="battery"
    else
        topicPrefix="battery${chainNum}"
    fi

    # BMS first index - default 1 (each ESP32 numbers its BMS from 1)
    # Override via setupOptions if using single ESP32 for multiple chains
    if [ -f "$setupOptionsDir/bmsFirst${chainNum}" ]; then
        bmsFirst=$(cat "$setupOptionsDir/bmsFirst${chainNum}")
    else
        bmsFirst=1
    fi

    echo ">>> Setting up Chain ${chainNum} service..."
    mkdir -p /service/$serviceName/log /var/log/$serviceName
    cat > /service/$serviceName/run << 'EOF'
#!/bin/sh
exec 2>&1
cd /data/apps/dbus-mqtt-battery
exec python3 dbus-mqtt-battery.py \
    --broker "$(cat /data/setupOptions/dbus-mqtt-battery/broker 2>/dev/null || echo "192.168.160.150")" \
    --batteries "$batteries" \
    --instance $instance \
    --topic-prefix "$topicPrefix" \
    --service-suffix "$dbusSuffix" \
    --product-name "JBD Battery Chain ${chainNum}" \
    --bms-first $bmsFirst
EOF
    chmod +x /service/$serviceName/run
    cat > /service/$serviceName/log/run << 'EOF'
exec svlogd -tt /var/log/dbus-mqtt-chain${chainNum}
EOF
    chmod +x /service/$serviceName/log/run
    echo "Created /service/dbus-mqtt-chain${chainNum}"
}

# Create all chain services
createChainServices() {
    for ((i=1; i<=chains; i++)); do
        createChainService $i
    done
}

# Main execution
case "$1" in
    "")
        # No arguments - show help
        echo "dbus-mqtt-battery SetupHelper script"
        echo "Usage: $0 {install|remove}"
        ;;
    install)
        readConfig
        createChainServices
        echo "  svstat /service/dbus-mqtt-chain*"
        ;;
    remove)
        echo "Removing dbus-mqtt-battery services..."
        for ((i=1; i<=10; i++)); do
            serviceName="dbus-mqtt-chain${i}"
            if [ -d "/service/$serviceName" ]; then
                svc -d "/service/$serviceName" 2>/dev/null || true
                svc -u "/service/$serviceName" 2>/dev/null || true
                rm -rf "/service/$serviceName"
                echo "  Removed $serviceName"
            fi
        done
        # Note: We don't stop the log services here as SetupHelper handles that
        ;;
    *)
        echo "Invalid command: $1"
        echo "Usage: $0 {install|remove}"
        exit 1
        ;;
esac
