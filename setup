#!/bin/bash

# dbus-mqtt-battery SetupHelper compatible setup script
# MQTT to D-Bus bridge for JBD BMS batteries on Victron Venus OS

#### following line incorporates SetupHelper resources into this script
source "/data/SetupHelper/HelperResources/IncludeHelpers"
#### end of lines to include helper resources

# Default configuration
defaultChains="2"
defaultBatteries="4"
defaultCellsPerBms="4"

# Read configuration from setupOptions
readConfig() {
    if [ -f "$setupOptionsDir/chains" ]; then
        chains=$(cat "$setupOptionsDir/chains")
    else
        chains="$defaultChains"
    fi

    if [ -f "$setupOptionsDir/batteries" ]; then
        batteries=$(cat "$setupOptionsDir/batteries")
    else
        batteries="$defaultBatteries"
    fi

    if [ -f "$setupOptionsDir/cellsPerBms" ]; then
        cellsPerBms=$(cat "$setupOptionsDir/cellsPerBms")
    else
        cellsPerBms="$defaultCellsPerBms"
    fi
}

# Create a chain service
createChainService() {
    local chainNum=$1
    local serviceName="dbus-mqtt-chain${chainNum}"
    local dbusSuffix="mqtt_chain${chainNum}"
    local instance=$((511 + chainNum))

    # Topic prefix: chain1=battery, chain2=battery2, chain3=battery3, etc.
    if [ "$chainNum" -eq 1 ]; then
        topicPrefix="battery"
    else
        topicPrefix="battery${chainNum}"
    fi

    # BMS first index - default 1 (each ESP32 numbers its BMS from 1)
    # Override via setupOptions if using single ESP32 for multiple chains
    if [ -f "$setupOptionsDir/bmsFirst${chainNum}" ]; then
        bmsFirst=$(cat "$setupOptionsDir/bmsFirst${chainNum}")
    else
        bmsFirst=1
    fi

    echo ">>> Setting up Chain ${chainNum} service..."
    # Persistent location: PackageManager/setup CHECK recreates the /service
    # symlink after reboot. Writing directly into /service is volatile.
    local baseDir="/data/dbus-mqtt-battery/service/${serviceName}"
    mkdir -p "$baseDir/log" /var/log/$serviceName
    # Bake config values at install time (unquoted heredoc): the run script
    # executes under svscan where these shell vars don't exist.
    local broker
    broker=$(cat /data/setupOptions/dbus-mqtt-battery/broker 2>/dev/null || echo "127.0.0.1")
    cat > "$baseDir/run" << EOF
#!/bin/sh
exec 2>&1
cd /data/dbus-mqtt-battery
exec python3 dbus-mqtt-battery.py \\
    --broker "$broker" \\
    --batteries "$batteries" \\
    --instance $instance \\
    --topic-prefix "$topicPrefix" \\
    --service-suffix "$dbusSuffix" \\
    --product-name "JBD Battery Chain ${chainNum}" \\
    --bms-first $bmsFirst
EOF
    chmod +x "$baseDir/run"
    cat > "$baseDir/log/run" << EOF
exec svlogd -tt /var/log/dbus-mqtt-chain${chainNum}
EOF
    chmod +x "$baseDir/log/run"
    ln -sfn "$baseDir" "/service/$serviceName"
    echo "Created $baseDir -> /service/$serviceName"
}

# Create all chain services
createChainServices() {
    for ((i=1; i<=chains; i++)); do
        createChainService $i
    done
}

# Ensure boot persistence: /service is tmpfs, so rc.local recreates the
# symlinks on every boot. Idempotent — only appends when block missing.
ensureRcLocalPersistence() {
    local rcLocal="/data/rc.local"
    if [ ! -f "$rcLocal" ]; then
        printf '#!/bin/sh\n' > "$rcLocal"
        chmod +x "$rcLocal"
    fi
    if ! grep -q "dbus-mqtt-chain1" "$rcLocal"; then
        cat >> "$rcLocal" << 'RCEOF'

# === dbus-mqtt-battery service persistence ===
# Recreate /service symlinks on boot (lost since /service is tmpfs)
ln -sfn /data/dbus-mqtt-battery/service/dbus-mqtt-chain1 /service/dbus-mqtt-chain1
ln -sfn /data/dbus-mqtt-battery/service/dbus-mqtt-chain2 /service/dbus-mqtt-chain2
sleep 2
svc -u /service/dbus-mqtt-chain1 2>/dev/null || true
svc -u /service/dbus-mqtt-chain2 2>/dev/null || true
# === end dbus-mqtt-battery ===
RCEOF
        echo "Added rc.local boot persistence block"
    fi
}

# Main execution
# NOTE: IncludeHelpers/CommonResources consumes command-line args and sets
# $scriptAction (CHECK exits early; INSTALL/UNINSTALL fall through to here).
case "$scriptAction" in
    INSTALL)
        readConfig
        createChainServices
        ensureRcLocalPersistence
        echo "  svstat /service/dbus-mqtt-chain*"
        ;;
    UNINSTALL)
        echo "Removing dbus-mqtt-battery services..."
        for ((i=1; i<=10; i++)); do
            serviceName="dbus-mqtt-chain${i}"
            baseDir="/data/dbus-mqtt-battery/service/${serviceName}"
            if [ -L "/service/$serviceName" ] || [ -d "/service/$serviceName" ]; then
                svc -d "/service/$serviceName" 2>/dev/null || true
                svc -u "/service/$serviceName" 2>/dev/null || true
                rm -f "/service/$serviceName"
                rm -rf "$baseDir"
                echo "  Removed $serviceName"
            fi
        done
        # Note: We don't stop the log services here as SetupHelper handles that
        ;;
    *)
        # CHECK action and no-arg help fall through to here
        echo "dbus-mqtt-battery SetupHelper script"
        echo "Usage: $0 {install|uninstall}  (dispatches on \$scriptAction)"
        ;;
esac
